/* ============================================================
   梅家坞茶园微气候智能体 · 全局样式
   设计体系延续网页版: 暖米白/松针墨绿双主题 · 茶青主色 · 大留白 · 语义风险色
   ============================================================ */

page {
  /* ---- 浅色主题(默认) ---- */
  --bg: #f8f7f1;
  --surface: #ffffff;
  --surface-2: #f2f0e9;
  --border: #e2e6e0;
  --text: #132419;
  --muted: #536257;
  --primary: #267543;
  --primary-dim: #5a966b;
  --amber: #b47825;
  --frost: #357b95;
  --danger: #c92f33;
  --chip-bg: #f2f0e9;

  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.65;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}

/* 深色主题令牌(跟随系统) */
@media (prefers-color-scheme: dark) {
  page {
    --bg: #060e09;
    --surface: #101a13;
    --surface-2: #18241c;
    --border: #223028;
    --text: #ebe8dc;
    --muted: #a19e94;
    --primary: #51af6f;
    --primary-dim: #22683b;
    --amber: #e7b551;
    --frost: #6eb7ce;
    --danger: #e8605b;
    --chip-bg: #18241c;
  }
}

/* ---------- 布局底座 ---------- */
.page {
  padding: 24rpx 28rpx 48rpx;
  box-sizing: border-box;
}

/* 页面大标题区(延续网页版品牌头部: 衬线标题 + 副标题) */
.brand {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 4rpx 8rpx;
}
.brand-title {
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.brand-sub {
  display: block;
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

/* ---------- 卡片与面板(统一 24rpx 圆角、留足内边距) ---------- */
.panel {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-top: 24rpx;
}
.panel-hd {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.panel-title {
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
  font-size: 32rpx;
  font-weight: 600;
}
.panel-note {
  font-size: 22rpx;
  color: var(--muted);
}

/* ---------- 状态条 ---------- */
.statusbar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 14rpx 24rpx;
  border: 1rpx solid var(--border);
  border-radius: 999rpx;
  background: var(--surface);
  font-size: 23rpx;
  color: var(--muted);
}
.statusbar .dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--primary);
  flex-shrink: 0;
}

/* ---------- 指标网格(2×2, 间隔充足) ---------- */
.grid-2 {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 24rpx;
}
.metric {
  flex: 0 0 calc(50% - 10rpx);
  box-sizing: border-box;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
}
.metric-label {
  font-size: 23rpx;
  color: var(--muted);
}
.metric-value {
  font-size: 52rpx;
  font-weight: 600;
  line-height: 1.25;
  margin: 6rpx 0 2rpx;
  font-variant-numeric: tabular-nums;
}
.metric-value .unit {
  font-size: 26rpx;
  font-weight: 400;
  margin-left: 4rpx;
  color: var(--muted);
}
.metric-sub {
  font-size: 21rpx;
  color: var(--muted);
}
.tone-amber { color: var(--amber); }
.tone-frost { color: var(--frost); }
.tone-primary { color: var(--primary); }
.tone-danger { color: var(--danger); }

/* ---------- 胶囊 chip ---------- */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 8rpx 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--border);
  background: var(--chip-bg);
  color: var(--muted);
  font-size: 24rpx;
  box-sizing: border-box;
}
.chip.g0 { color: var(--primary); border-color: rgba(38, 117, 67, 0.4); }
.chip.g1 { color: var(--amber); border-color: rgba(180, 120, 37, 0.45); }
.chip.g2 { color: var(--amber); border-color: var(--amber); }
.chip.g3 { color: var(--danger); border-color: var(--danger); }
.chip.active { color: var(--primary); border-color: var(--primary); background: var(--surface); }

/* ---------- 按钮(触控 ≥ 88rpx) ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}
.btn::after { border: none; }
.btn-primary {
  background: var(--primary);
  color: #ffffff;
}
.btn-primary[disabled] { opacity: 0.5; color: #ffffff; }
.btn-ghost {
  background: var(--surface);
  border: 1rpx solid var(--border);
  color: var(--muted);
}

/* ---------- 风险行 ---------- */
.risk-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx dashed var(--border);
}
.risk-row:last-child { border-bottom: none; padding-bottom: 6rpx; }
.risk-window {
  font-family: "Songti SC", "STSong", serif;
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.risk-chips { display: flex; gap: 12rpx; flex-wrap: wrap; justify-content: flex-end; }
.risk-detail {
  width: 100%;
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 6rpx;
}

/* ---------- 说明文字与脚注 ---------- */
.note {
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.7;
  border-left: 4rpx solid var(--border);
  padding-left: 16rpx;
  margin-top: 16rpx;
}
.empty {
  text-align: center;
  color: var(--muted);
  font-size: 24rpx;
  padding: 60rpx 0;
}
.loading-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  color: var(--muted);
  font-size: 24rpx;
  padding: 40rpx 0;
}
.spinner {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid var(--border);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ---------- 对话气泡 ---------- */
.chat-msg {
  display: flex;
  margin-bottom: 24rpx;
}
.chat-msg.user { justify-content: flex-end; }
.bubble {
  max-width: 82%;
  padding: 20rpx 26rpx;
  border-radius: 22rpx;
  font-size: 27rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-word;
}
.chat-msg.agent .bubble {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-bottom-left-radius: 8rpx;
}
.chat-msg.user .bubble {
  background: var(--primary);
  color: #ffffff;
  border-bottom-right-radius: 8rpx;
}

/* ---------- 输入行 ---------- */
.input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--surface);
  border-top: 1rpx solid var(--border);
}
.input-row .field {
  flex: 1;
  min-height: 84rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--border);
  font-size: 27rpx;
  box-sizing: border-box;
}
.input-row .send {
  min-width: 140rpx;
  min-height: 84rpx;
  border-radius: 999rpx;
  background: var(--primary);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.input-row .send[disabled] { opacity: 0.5; }
