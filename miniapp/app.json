{
  "pages": [
    "pages/index/index",
    "pages/chat/chat",
    "pages/map/map",
    "pages/data/data"
  ],
  "window": {
    "navigationBarBackgroundColor": "@navBgColor",
    "navigationBarTextStyle": "@navTxtStyle",
    "navigationBarTitleText": "梅家坞茶园微气候",
    "backgroundColor": "@bgColor",
    "backgroundTextStyle": "@bgTxtStyle",
    "enablePullDownRefresh": false
  },
  "tabBar": {
    "color": "@tabBarColor",
    "selectedColor": "@tabBarSelectedColor",
    "backgroundColor": "@tabBarBgColor",
    "borderStyle": "@tabBarBorderStyle",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "大盘",
        "iconPath": "assets/tabbar/home.png",
        "selectedIconPath": "assets/tabbar/home-active.png"
      },
      {
        "pagePath": "pages/chat/chat",
        "text": "农事助手",
        "iconPath": "assets/tabbar/chat.png",
        "selectedIconPath": "assets/tabbar/chat-active.png"
      },
      {
        "pagePath": "pages/map/map",
        "text": "地图选点",
        "iconPath": "assets/tabbar/map.png",
        "selectedIconPath": "assets/tabbar/map-active.png"
      },
      {
        "pagePath": "pages/data/data",
        "text": "数据接入",
        "iconPath": "assets/tabbar/data.png",
        "selectedIconPath": "assets/tabbar/data-active.png"
      }
    ]
  },
  "darkmode": true,
  "themeLocation": "theme.json",
  "lazyCodeLoading": "requiredComponents",
  "sitemapLocation": "sitemap.json"
}
